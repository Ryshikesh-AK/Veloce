# DriveXCars PWA Environment Variable Template
# Copy this file to .env.local for local overrides

# Backend API Base URL
VITE_API_BASE_URL=http://localhost:8000

# Network Request Timeout in Milliseconds (Default: 12000)
VITE_API_TIMEOUT_MS=12000

# Enable fallback to local mock data if backend API is unreachable (Default: true in dev, false in prod)
VITE_ENABLE_MOCK_FALLBACK=true

# Application Name
VITE_APP_NAME="DriveXCars Motors"
